# Cổng chạy API
PORT=4000

# BẮT BUỘC khi chạy thật: chuỗi bí mật dài và ngẫu nhiên để ký JWT.
# Tạo nhanh:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Phiên đăng nhập sống 90 ngày và tự gia hạn mỗi lần mở app (chỉ hết khi bấm Đăng xuất
# hoặc 90 ngày liền không mở). Cookie HttpOnly, Secure khi production, SameSite=Lax.

# Địa chỉ frontend được phép gọi API. Nhiều địa chỉ thì ngăn cách bằng dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173

# Đặt production khi chạy thật. Khi đó thiếu JWT_SECRET, API sẽ không khởi động.
NODE_ENV=development

# Bật khi API chạy sau proxy (Railway, Render, Nginx) để đọc đúng IP người dùng.
# TRUST_PROXY=1

# Tài khoản quản trị đầu tiên, chỉ dùng cho lệnh `npm run seed`.
# ADMIN_EMAIL=chu-cua-hang@tenmien.vn
# ADMIN_PASSWORD=
# Required for first seed in ALL environments: use a unique 12+ character password.
# COOKIE_SAME_SITE=none  # Only for separate frontend/backend sites on production HTTPS.
# DATA_DIR=/var/data/gao-shop

# Database bền vững cho Vercel. Khi kết nối Turso từ Vercel Marketplace, hai biến
# TURSO_* này được tạo tự động. LIBSQL_URL / LIBSQL_AUTH_TOKEN cũng được hỗ trợ.
# TURSO_DATABASE_URL=libsql://ten-database.turso.io
# TURSO_AUTH_TOKEN=

# Preview dùng database riêng, tuyệt đối không trỏ vào Production.
# PREVIEW_TURSO_DATABASE_URL=libsql://database-preview-rieng.turso.io
# PREVIEW_TURSO_AUTH_TOKEN=
# Chỉ Production build chạy migrate -- --deploy; xem README trước khi triển khai.

# --- Thông báo đẩy báo đơn mới khi điện thoại quản trị tắt màn hình (Web Push) ---
# Tạo cặp khoá một lần:  npx web-push generate-vapid-keys   (trong thư mục backend)
# Khoá công khai được API gửi cho trình duyệt (GET /api/push/config), không cần biến VITE_.
# Khoá riêng là BÍ MẬT: chỉ đặt trong Vercel → Settings → Environment Variables, không đưa lên Git.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@gaokinhbac.vn

# --- Telegram dự phòng (không bắt buộc) ---
# Tạo bot với @BotFather để lấy token; thêm bot vào nhóm của cửa hàng rồi lấy chat id của nhóm.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Địa chỉ trang dùng cho link "Mở đơn" trong tin Telegram (để trống thì tự lấy tên miền Vercel).
# PUBLIC_SITE_URL=https://gao-kinh-bac-preview.vercel.app
