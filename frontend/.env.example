# Địa chỉ API backend.
# - Khi chạy dev: để trống, Vite đã proxy /api sang http://localhost:4000
# - Khi frontend và API cùng deploy trong dự án Vercel này: để trống (khuyến nghị)
# - Chỉ điền khi backend nằm ở tên miền khác, ví dụ https://api.tenmien.vn
VITE_API_URL=

# Địa chỉ ứng dụng sau khi deploy, dùng để tạo ảnh xem trước khi chia sẻ.
# Ví dụ: https://gao-nha-minh.vercel.app
VITE_SITE_URL=
